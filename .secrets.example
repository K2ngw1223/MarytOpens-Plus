# MarytOpens · Worker 密钥模板
# 复制本文件为 .secrets 并填入真实值： cp .secrets.example .secrets
# .secrets 已被 .gitignore 忽略，不会进入仓库。
# 仅填下面“必填”项即可部署；OAuth / Turnstile 的 Client Secret 也在此填写。

# ---------- 必填 ----------
# JWT 签名密钥（建议：openssl rand -hex 32）
JWT_SECRET=

# 超级管理员密码（强密码）
SUPER_ADMIN_PASSWORD=

# Cloud Mail 邮局 API Token（自建邮局，用于发送注册/登录验证码）
MAIL_API_TOKEN=

# ---------- 人机验证 Cloudflare Turnstile ----------
TURNSTILE_SECRET=

# ---------- 第三方登录 OAuth（Client Secret） ----------
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_SECRET=

# ---------- 用户绑定自己的 Cloudflare 账号 ----------
# 在 dash.cloudflare.com → 个人资料 → OAuth 应用中创建，回调填
# https://api.natrois.top/api/cf/bind/callback
CF_OAUTH_CLIENT_SECRET=

# 用户令牌 AES-GCM 加密密钥（建议独立于 JWT_SECRET：openssl rand -hex 32）
ENCRYPTION_SECRET=

# ---------- 可选 ----------
# 若 Worker 需要代你管理 Cloudflare 资源（如自动建 KV/D1 时），
# 可填具备相应权限的 API Token 与账户/区域 ID；留空则仅在用户自行绑定时使用用户自己的令牌。
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=

# Discord 机器人主令牌（若启用机器人）
BOT_MASTER_TOKEN=
