# ---- Discord 机器人 ----
# 在 https://discord.com/developers/applications 创建 Bot 应用后获取
DISCORD_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_guild_id

# ---- MarytOpens 平台 ----
# 在站点管理后台「机器人」面板创建的令牌（X-Bot-Token）
MO_BOT_TOKEN=your_marytopens_bot_token
# 可选：覆盖默认 API 基址（本地联调时改为 http://127.0.0.1:8787）
MO_API_BASE=https://api.natrois.top
